# AnyBox Configuration
# Configure these variables in your Vercel Dashboard (Project Settings -> Environment Variables)
# or in a local .env.local file for local development.

# Default attestation source engine: specter | integritybox | upstream
DEFAULT_SOURCE=specter

# Specter (rawbin) Configuration (Optional overrides)
# SPECTER_CATALOG_URL=https://rawbin.dpejoh.com/catalog
# SPECTER_KEYBOX_URL=https://rawbin.dpejoh.com/key

# Integrity-Box (MeowDump) Configuration (Optional overrides)
# INTEGRITY_BOX_KEYBOX_URL=https://raw.githubusercontent.com/MeowDump/MeowDump/refs/heads/main/Megatron
# INTEGRITY_BOX_STATUS_URL=https://raw.githubusercontent.com/MeowDump/Integrity-Box/refs/heads/main/keybox/key-status

# Custom Upstream Source Configuration (Optional)
KEYBOX_SOURCE_URL=https://example.com/key
STATUS_SOURCE_URL=https://example.com/status

# Local Development Server Port
PORT=3000
